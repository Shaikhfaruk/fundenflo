NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
CORS_ORIGINS=https://www.fundenflo.com
API_ORIGIN=https://www.fundenflo.com
APP_ORIGIN=https://www.fundenflo.com

DATABASE_URL=postgresql://USER:PASSWORD@YOURSERVER.postgres.database.azure.com:5432/fundenflo?sslmode=require
REDIS_URL=redis://valkey:6379

JWT_ISSUER=fundenflo-api
JWT_AUDIENCE=fundenflo-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_SIGNING_KEYS=
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90

CRYPTO_DRIVER=azure_key_vault
CRYPTO_ACTIVE_KEY_ID=
CRYPTO_WRAPPED_KEYS=
KEY_VAULT_KEY_ID=https://YOURVAULT.vault.azure.net/keys/KEYNAME/VERSION
BLIND_INDEX_KEY=
OTP_HASH_KEY=
AUTH_OTP_STATIC_CODE=

SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
EMAIL_DRIVER=smtp
SMTP_URL=
EMAIL_FROM=
PUSH_DRIVER=expo
EXPO_ACCESS_TOKEN=

STORAGE_DRIVER=azure_blob
STORAGE_ACCOUNT_URL=
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER=fundenflo-private

KYC_DRIVER=stub
EXTRACTION_DRIVER=manual
ANTIVIRUS_DRIVER=eicar

STAFF_INVITE_ACCEPT_URL=https://www.fundenflo.com/staff/invite
CONSENT_LINK_URL=https://www.fundenflo.com/consent
LEAD_DROPOFF_DELAY_HOURS=24

GOOGLE_TRANSLATE_API_KEY=
APP_VERSION=
