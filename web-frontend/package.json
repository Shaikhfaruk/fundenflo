{
  "name": "web-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src tests scripts",
    "lint:spacing": "node scripts/check-spacing.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:routes": "node scripts/sync-backend-routes.mjs",
    "api:coverage": "node scripts/api-coverage.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "i18n:translate": "node scripts/translate-messages.mjs",
    "knip": "knip",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:spacing && pnpm knip && pnpm test && pnpm api:coverage && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "5.9.1",
    "@iconify-icons/material-symbols": "2.0.4",
    "@iconify/react": "6.0.2",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "input-otp": "1.5.0",
    "motion": "13.4.4",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.2",
    "knip": "6.41.0",
    "otplib": "13.5.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.1.0"
}
