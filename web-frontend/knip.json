{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,manifest}.{ts,tsx}",
    "scripts/*.mjs",
    "tests/e2e/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/*.mjs",
    "tests/**/*.ts"
  ],
  "ignore": [
    "src/components/ui/**",
    "src/lib/api/backend-routes.ts"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "shadcn",
    "tailwindcss"
  ]
}
