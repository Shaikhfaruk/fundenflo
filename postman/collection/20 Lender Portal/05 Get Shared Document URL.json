{
  "name": "Get Shared Document URL",
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{baseUrl}}/lender/submissions/:id/documents/:documentId/download-url",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "lender",
        "submissions",
        ":id",
        "documents",
        ":documentId",
        "download-url"
      ],
      "variable": [
        {
          "key": "id",
          "value": "{{submissionId}}"
        },
        {
          "key": "documentId",
          "value": "{{sharedDocumentId}}"
        }
      ]
    },
    "description": "A short-lived read link for one document shared with this submission; every link issued is audited. Lender context: admins and credit officers act, viewers read. Only files already sent to the signed-in lender's organization are visible."
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
