{
  "name": "Schedule Lead Follow-Up",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/ops/leads/:id/follow-ups",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "ops",
        "leads",
        ":id",
        "follow-ups"
      ],
      "variable": [
        {
          "key": "id",
          "value": "{{leadId}}"
        }
      ]
    },
    "description": "Schedules a follow-up for yourself on a lead. `dueAt` must be in the future and at most 180 days ahead. Staff only. Staff activities are visible to staff only.",
    "body": {
      "mode": "raw",
      "raw": "{\n  \"dueAt\": \"{{followUpDueAt}}\",\n  \"note\": \"Re-check interest after Diwali\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('followUpDueAt', new Date(Date.now() + 24 * 3600 * 1000).toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('opsFollowUpId', String(pm.response.json().id));",
          "pm.collectionVariables.set('opsFollowUpVersion', String(pm.response.json().version));"
        ]
      }
    }
  ],
  "response": [
    {
      "name": "201 Created",
