{
  "name": "Add Application Party",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/applications/:id/parties",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "applications",
        ":id",
        "parties"
      ],
      "variable": [
        {
          "key": "id",
          "value": "{{applicationId}}"
        }
      ]
    },
    "description": "Adds a co-applicant, guarantor or director by name and mobile (matched to an existing person or created, like lead capture). Their consent starts `pending` and holds the journey at the consent step (`parties_consent_pending`) until they confirm by OTP. At most 10 per application; only before submission. Borrower context for the applicant's own records; partner context for applications the firm filed (agents: the ones they filed). Others get 404.",
    "body": {
      "mode": "raw",
      "raw": "{\n  \"role\": \"co_applicant\",\n  \"name\": \"Meena Kapoor\",\n  \"mobile\": \"{{coApplicantMobile}}\",\n  \"relationship\": \"spouse\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('coApplicantMobile', `9${Math.floor(100000000 + Math.random() * 899999999)}`);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('applicationPartyId', String(pm.response.json().id));"
        ]
      }
    }
  ],
