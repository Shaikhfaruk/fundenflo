{
  "name": "Submit Application Answers",
  "request": {
    "method": "PUT",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/applications/:id/answers",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "applications",
        ":id",
        "answers"
      ],
      "variable": [
        {
          "key": "id",
          "value": "{{applicationId}}"
        }
      ]
    },
    "description": "Records answers for the application's borrower party; each answer also writes a declared fact. When every required pre-check question is answered, a draft becomes `pre_screened`. Borrower context (the applicant's own records, reached through their login); partner context sees applications its firm filed (M3c). Lists and reads never show other people's records.",
    "body": {
      "mode": "raw",
      "raw": "{\n  \"stage\": \"pre_check\",\n  \"answers\": [\n    {\n      \"questionKey\": \"business_age\",\n      \"value\": \"3-5\"\n    },\n    {\n      \"questionKey\": \"monthly_turnover\",\n      \"value\": \"5-25L\"\n    },\n    {\n      \"questionKey\": \"existing_emis\",\n      \"value\": \"no\"\n    },\n    {\n      \"questionKey\": \"gst_registered\",\n      \"value\": \"yes\"\n    }\n  ]\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 200', () => pm.response.to.have.status(200));"
        ]
      }
    }
  ],
