{
  "name": "Compat Verify OTP",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{rootUrl}}/v0/auth/otp/verify",
      "host": [
        "{{rootUrl}}"
      ],
      "path": [
        "v0",
        "auth",
        "otp",
        "verify"
      ]
    },
    "description": "Same as `POST /v1/auth/otp/verify` plus `token` (the access token under the name the app reads) and `user.mobile` without the country code. Compat layer for the current app (plan §10.3): the app sets `EXPO_PUBLIC_API_URL=<host>/v0`. The case is the borrower's newest open application, resolved server side because the app never sends one. Removed once the app moves to `/v1`.",
    "auth": {
      "type": "noauth"
    },
    "body": {
      "mode": "raw",
      "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"otp\": \"{{otp}}\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.collectionVariables.set('accessToken', body.token);",
          "pm.collectionVariables.set('refreshToken', body.refreshToken);",
          "pm.collectionVariables.set('userId', body.user.id);"
        ]
      }
    }
  ],
