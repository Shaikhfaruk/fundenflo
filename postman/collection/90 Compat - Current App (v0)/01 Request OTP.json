{
  "name": "Compat Request OTP",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{rootUrl}}/v0/auth/otp/request",
      "host": [
        "{{rootUrl}}"
      ],
      "path": [
        "v0",
        "auth",
        "otp",
        "request"
      ]
    },
    "description": "Same as `POST /v1/auth/otp/request` (borrower sign-in; `referralCode` credits a CA). Compat layer for the current app (plan §10.3): the app sets `EXPO_PUBLIC_API_URL=<host>/v0`. The case is the borrower's newest open application, resolved server side because the app never sends one. Removed once the app moves to `/v1`.",
    "auth": {
      "type": "noauth"
    },
    "body": {
      "mode": "raw",
      "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"countryCode\": \"+91\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 200', () => pm.response.to.have.status(200));"
        ]
      }
    }
  ],
  "response": [
    {
