    "body": {
      "mode": "raw",
      "raw": "{\n  \"membershipNumber\": \"ICAI-123456\",\n  \"pan\": \"{{partnerPan}}\",\n  \"gstin\": \"06{{partnerPan}}1Z5\",\n  \"bankAccount\": {\n    \"accountNumber\": \"502000123456789\",\n    \"ifsc\": \"HDFC0001234\",\n    \"holderName\": \"Postman Flow Firm\"\n  }\n}",
