{
  "name": "Recompute Assessment",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/ops/assessments/:id/recompute",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "ops",
        "assessments",
        ":id",
        "recompute"
      ],
      "variable": [
        {
          "key": "id",
          "value": "{{scoreResultId}}"
        }
      ]
    },
    "description": "`reproduce` recomputes a stored result from its own model version, inputs and consents and says whether it `matches` (nothing is stored). `current` scores the case again with the published model and current facts and stores a new result. Staff context.",
    "body": {
      "mode": "raw",
      "raw": "{\n  \"mode\": \"reproduce\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 200', () => pm.response.to.have.status(200));"
        ]
      }
    }
  ],
  "response": [
