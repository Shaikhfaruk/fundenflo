          "pm.collectionVariables.set('documentRequirementId', String(pm.response.json().id));",
          "pm.collectionVariables.set('documentRequirementDocVersion', String(pm.response.json().version));",
          "pm.collectionVariables.set('documentRequirementNumber', String(pm.response.json().openVersion.number));"
        ]
      }
    }
  ],
