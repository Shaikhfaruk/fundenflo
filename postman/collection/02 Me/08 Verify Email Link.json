{
  "name": "Verify Email Link",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/me/logins/verify",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "me",
        "logins",
        "verify"
      ]
    },
    "description": "Confirms the email OTP and links the email as a sign-in method. The email also becomes the primary email contact.",
    "body": {
      "mode": "raw",
      "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"otp\": \"{{otp}}\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('loginId', pm.response.json().id);"
        ]
      }
    }
  ],
