{
  "name": "Accept Staff Invitation",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/auth/staff/invitations/accept",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "auth",
        "staff",
        "invitations",
        "accept"
      ]
    },
    "description": "Accepts a FundenFlo staff invitation sent by email and sets the staff password (12-128 characters). Each invitation can be used once.",
    "auth": {
      "type": "noauth"
    },
    "body": {
      "mode": "raw",
      "raw": "{\n  \"token\": \"{{staffInviteToken}}\",\n  \"fullName\": \"{{staffFullName}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 200', () => pm.response.to.have.status(200));"
        ]
      }
    }
  ],
