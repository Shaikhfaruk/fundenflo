{
  "name": "Staff Login",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/auth/staff/login",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "auth",
        "staff",
        "login"
      ]
    },
    "description": "First step of staff sign-in. Returns an `mfaToken` valid for 5 minutes. On the first sign-in `mfaSetup` contains the TOTP secret and otpauth URL to enrol an authenticator app. Five wrong passwords lock the account for 15 minutes.",
    "auth": {
      "type": "noauth"
    },
    "body": {
      "mode": "raw",
      "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.collectionVariables.set('mfaToken', body.mfaToken);",
          "if (body.mfaSetup) pm.collectionVariables.set('totpSecret', body.mfaSetup.secret);"
        ]
      }
    }
