{
  "name": "Verify Staff MFA",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/auth/staff/mfa/verify",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "auth",
        "staff",
        "mfa",
        "verify"
      ]
    },
    "description": "Second step of staff sign-in with the 6-digit authenticator code. The pre-request script computes the code from `totpSecret` for testing. Each code works once.",
    "auth": {
      "type": "noauth"
    },
    "body": {
      "mode": "raw",
      "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\",\n  \"code\": \"{{totpCode}}\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const cryptoJs = require('crypto-js');",
          "const secret = pm.collectionVariables.get('totpSecret') || '';",
          "const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
          "let bits = '';",
          "for (const char of secret.replace(/=+$/, '').toUpperCase()) bits += alphabet.indexOf(char).toString(2).padStart(5, '0');",
          "const keyHex = (bits.match(/.{8}/g) || []).map((byte) => parseInt(byte, 2).toString(16).padStart(2, '0')).join('');",
          "const counter = Math.floor(Date.now() / 30000).toString(16).padStart(16, '0');",
          "const hmac = cryptoJs.HmacSHA1(cryptoJs.enc.Hex.parse(counter), cryptoJs.enc.Hex.parse(keyHex)).toString(cryptoJs.enc.Hex);",
          "const offset = parseInt(hmac.slice(-1), 16);",
          "const code = (parseInt(hmac.slice(offset * 2, offset * 2 + 8), 16) & 0x7fffffff) % 1000000;",
          "pm.collectionVariables.set('totpCode', String(code).padStart(6, '0'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.collectionVariables.set('accessToken', body.accessToken);",
          "pm.collectionVariables.set('refreshToken', body.refreshToken);",
          "pm.collectionVariables.set('userId', body.user.id);",
          "pm.collectionVariables.set('partyVersion', String(body.user.version));",
          "if (body.user.activeContext) pm.collectionVariables.set('membershipId', body.user.activeContext.membershipId);",
          "const borrower = body.user.memberships.find((membership) => membership.context === 'borrower');",
          "if (borrower) pm.collectionVariables.set('borrowerMembershipId', borrower.id);",
          "if (body.user.activeContext && body.user.activeContext.organization) pm.collectionVariables.set('organizationId', body.user.activeContext.organization.id);",
          "pm.test('returns tokens and the signed-in user', () => {",
          "  pm.expect(body.tokenType).to.eql('Bearer');",
          "  pm.expect(body.user.id).to.be.a('string');",
          "});"
        ]
      }
    }
  ],
