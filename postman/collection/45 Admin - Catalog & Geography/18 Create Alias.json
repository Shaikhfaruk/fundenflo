{
  "name": "Create Alias",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "Idempotency-Key",
        "value": "{{$guid}}"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/admin/lookup-aliases",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "admin",
        "lookup-aliases"
      ]
    },
    "description": "Adds an alias. The alias is stored normalised (lowercase, no punctuation) and must be unique per kind. Staff only. Reading needs catalog read access (ops lead, compliance, support); changes need catalog manage access (ops lead, super admin). Every change is audited and clears the public catalog cache immediately.",
    "body": {
      "mode": "raw",
      "raw": "{\n  \"kind\": \"city\",\n  \"alias\": \"thana {{$timestamp}}\",\n  \"targetId\": \"{{cityId}}\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('aliasId', String(pm.response.json().id));"
        ]
      }
    }
  ],
