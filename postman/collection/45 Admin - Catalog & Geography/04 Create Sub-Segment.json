      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('subSegmentId', String(pm.response.json().id));",
          "pm.collectionVariables.set('subSegmentVersion', String(pm.response.json().version));"
        ]
      }
    }
