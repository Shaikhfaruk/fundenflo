        }
      ]
    },
    "description": "Adds a sub-segment (for example a constitution type) to a segment. Staff only. Reading needs catalog read access (ops lead, compliance, support); changes need catalog manage access (ops lead, super admin). Every change is audited and clears the public catalog cache immediately.",
    "body": {
      "mode": "raw",
      "raw": "{\n  \"key\": \"sub{{$timestamp}}\",\n  \"label\": {\n    \"en\": \"Public Charitable Trust\"\n  }\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
