        "{{baseUrl}}"
      ],
      "path": [
        "partner",
        "members"
      ]
    },
    "description": "Invites a staff member (`partner_agent`) by mobile. They join automatically the first time they sign in as a partner with that number; an SMS tells them. Owner only. Partner context (CA, DSA or connector firm members). Reading needs a partner membership; changes need the firm owner.",
    "body": {
      "mode": "raw",
      "raw": "{\n  \"mobile\": \"{{memberMobile}}\",\n  \"countryCode\": \"+91\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('memberMobile')) pm.collectionVariables.set('memberMobile', '97' + String(Math.floor(Math.random() * 1e8)).padStart(8, '0'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds 201', () => pm.response.to.have.status(201));"
