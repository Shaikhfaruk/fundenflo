{
  "name": "Deactivate Lead Source",
  "request": {
    "method": "PATCH",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "If-Match",
        "value": "\"{{leadSourceVersion}}\""
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/admin/lead-sources/:id",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "admin",
        "lead-sources",
        ":id"
      ],
      "variable": [
        {
          "key": "id",
          "value": "{{leadSourceId}}"
        }
      ]
    },
    "description": "Deactivates a lead source (status `inactive`) so it stops accepting new leads; leads already captured keep it. Flows use it to clean up the sources they create. Staff with lead source manage access.",
    "body": {
      "mode": "raw",
      "raw": "{\n  \"status\": \"inactive\"\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "event": [
    {
      "listen": "test",
