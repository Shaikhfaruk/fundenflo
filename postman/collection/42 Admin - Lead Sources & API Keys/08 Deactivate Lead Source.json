        "type": "text/javascript",
        "exec": [
          "pm.test('responds 200', () => pm.response.to.have.status(200));",
          "pm.test('is inactive', () => pm.expect(pm.response.json().status).to.eql('inactive'));"
        ]
      }
    }
  ],
