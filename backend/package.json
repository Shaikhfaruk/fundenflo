{
  "name": "fundenflo-api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"../postman/scripts/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "keys:generate": "node dist/scripts/generate-keys.js",
    "keys:reencrypt": "node dist/scripts/reencrypt-keys.js",
    "staff:invite": "node dist/scripts/invite-staff.js",
    "postman:build": "node ../postman/scripts/build.ts",
    "postman:split": "node ../postman/scripts/split.ts",
    "postman:coverage": "node ../postman/scripts/coverage.ts",
    "postman:flows": "node ../postman/scripts/run-flows.ts",
    "inventory:check": "node dist/scripts/inventory-check.js"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@azure/keyvault-keys": "4.10.2",
    "@azure/storage-blob": "12.34.0",
    "@casl/ability": "7.0.1",
    "@casl/prisma": "2.0.2",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/websockets": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.12",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.15",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.0.16",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "newman": "6.2.3",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.3",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
