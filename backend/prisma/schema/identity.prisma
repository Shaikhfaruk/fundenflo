enum UserStatus {
  active
  suspended
  deleted
}

enum LoginMethod {
  mobile_otp
  email_otp
  password
  google
  apple
}

enum OtpPurpose {
  login
  link_login
  mobile_change
  consent
}

enum LoginAs {
  borrower
  ca
  dsa
  lender
}

enum SessionContext {
  none
  borrower
  partner
  lender
  staff
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  partyId            String     @unique @map("party_id") @db.Uuid
  status             UserStatus @default(active)
  signupChannel      String     @map("signup_channel")
  signupReferralCode String?    @map("signup_referral_code")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  version            Int        @default(1)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  party           Party            @relation(fields: [partyId], references: [id], onDelete: Restrict)
  logins          UserLogin[]
  sessions        Session[]
  memberships     Membership[]
  staffCredential StaffCredential?

  @@index([status, createdAt])
  @@map("users")
}

model UserLogin {
  id               String      @id @default(uuid(7)) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  method           LoginMethod
  identifierHash   String      @map("identifier_hash")
  identifierEnc    String      @map("identifier_enc")
  identifierMasked String      @map("identifier_masked")
  verifiedAt       DateTime    @map("verified_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?   @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([method, identifierHash])
  @@index([userId])
  @@map("user_logins")
}

model StaffCredential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash")
  totpSecretEnc     String?   @map("totp_secret_enc")
  totpEnabledAt     DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime  @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("staff_credentials")
}

model OtpChallenge {
  id                String      @id @default(uuid(7)) @db.Uuid
  purpose           OtpPurpose
  channel           ContactType
  identifierHash    String      @map("identifier_hash")
  codeHash          String      @map("code_hash")
  userId            String?     @map("user_id") @db.Uuid
  loginAs           LoginAs?    @map("login_as")
  payload           Json?
  attempts          Int         @default(0)
  maxAttempts       Int         @map("max_attempts")
  expiresAt         DateTime    @map("expires_at") @db.Timestamptz(3)
  resendAvailableAt DateTime    @map("resend_available_at") @db.Timestamptz(3)
  consumedAt        DateTime?   @map("consumed_at") @db.Timestamptz(3)
  ip                String?
  userAgent         String?     @map("user_agent")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifierHash, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model Session {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  membershipId String?        @map("membership_id") @db.Uuid
  context      SessionContext
  loginMethod  LoginMethod    @map("login_method")
  deviceId     String?        @map("device_id")
  deviceName   String?        @map("device_name")
  platform     String?
  ip           String?
  userAgent    String?        @map("user_agent")
  pushToken    String?        @map("push_token")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt   DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?        @map("revoke_reason")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership    Membership?    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([membershipId])
  @@map("sessions")
}

model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([familyId])
  @@map("refresh_tokens")
}
